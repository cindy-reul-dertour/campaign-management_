/**
 * last update: 13.10.26, CR
 * version: 1.0
 *
 * Collects keywords from the source campaigns of a job within this account
 * and adds the new ones to the negative keyword list of the same account.
 */

// ==================== CONFIGURATION ====================

// One entry per use case. Add a further use case by adding another object.
// campaignIds: source campaigns in THIS single account (several IDs possible)
// listId:      negative keyword list in THIS single account (shared set ID)
var JOBS = [
  {
    name: 'konkurrenz',
    campaignIds: [23890687808],
    listId: 12216338825
  },
  // {
  //   name: 'generic',
  //   campaignIds: [21050017653],
  //   listId: 12212238753
  // }
];

// 'PAUSED' | 'ENABLED' | '' (= any campaign status except REMOVED)
var CAMPAIGN_STATUS = '';

// Ad groups containing these strings are skipped entirely
// (checked case-insensitive -> covers "zz-OLD" and "zz-old")
var EXCLUDE_ADGROUP_CONTAINS = ['zz-old'];

var DRY_RUN = false;              // true = change nothing

// --- Error notification ---
var ERROR_EMAIL = 'cindy.reul@dertour.com';     // recipient of the alert mail
var ERROR_SUBJECT = 'Fehlermeldung: Script fehlgeschlagen';
var SCRIPT_NAME = 'Script Suchbegriffe';        // name used in the body of the alert mail
var ACCOUNT_LABEL = 'Dertour Hotels';

// =======================================================

function main() {
  var errors = [];

  for (var j = 0; j < JOBS.length; j++) {
    var job = JOBS[j];
    try {
      runJob_(job);
    } catch (error) {
      var message = (error && error.message) ? error.message : String(error);
      errors.push('Job "' + job.name + '": ' + message);
      Logger.log('Job "' + job.name + '" failed: ' + message);
      if (error && error.stack) {
        Logger.log(error.stack);
      }
    }
  }

  if (errors.length) {
    try {
      sendErrorMail(errors);
    } catch (mailError) {
      Logger.log('Alert mail could not be sent: ' + mailError);
    }
    throw new Error(errors.length + ' error(s): ' + errors.join(' | '));
  }
}

/** Runs a single use case. */
function runJob_(job) {
  var account = AdsApp.currentAccount();

  // --- Phase 1: collect keywords from the source campaigns ---
  var targetKeywords = collectSourceKeywords_(job.campaignIds);

  // --- Phase 2: read the negative keyword list ---
  var list = getNegativeKeywordList_(job.listId);
  if (!list) {
    throw new Error('Negative keyword list with ID ' + job.listId + ' not found in account ' +
                    account.getCustomerId() + '. Check that the list lives in this account ' +
                    'and the ID is correct.');
  }

  var currentEntries = getListEntries_(list);

  // Only keywords that are not yet in the list (existing entries stay untouched)
  var toAdd = [];
  for (var key in targetKeywords) {
    if (!currentEntries.hasOwnProperty(key)) {
      toAdd.push(targetKeywords[key]);
    }
  }

  // Nothing new to add -> alert
  if (!toAdd.length) {
    if (DRY_RUN) {
      Logger.log('DRY RUN - job "' + job.name + '" - no new keywords.');
      return;
    }
    throw new Error('Kein neues Keyword zum Ausschließen gefunden ' +
                    '(Quell-Keywords: ' + countKeys_(targetKeywords) +
                    ', Einträge in der Liste: ' + countKeys_(currentEntries) +
                    '). Bitte Script und Kampagnen prüfen.');
  }

  if (DRY_RUN) {
    Logger.log('DRY RUN - job "' + job.name + '" - to add: ' + toAdd.length);
    return;
  }

  // --- Phase 3: add the new keywords ---
  var CHUNK = 1000;
  for (var i = 0; i < toAdd.length; i += CHUNK) {
    list.addNegativeKeywords(toAdd.slice(i, i + CHUNK));
  }

  Logger.log('Job "' + job.name + '" - added: ' + toAdd.length);
}

// Sends the alert mail (max. 50 error lines, rest is in the script log)
function sendErrorMail(errors) {
  var account = AdsApp.currentAccount();
  var maxLines = 50;
  var lines = errors.slice(0, maxLines);
  if (errors.length > maxLines) {
    lines.push('... and ' + (errors.length - maxLines) + ' more errors (see script log).');
  }

  var body =
    'Script: ' + SCRIPT_NAME + '\n' +
    'Account: ' + ACCOUNT_LABEL + ' (' + account.getCustomerId() + ')\n' +
    'Time: ' + Utilities.formatDate(new Date(), account.getTimeZone(), 'yyyy-MM-dd HH:mm:ss') + '\n\n' +
    'Errors:\n' + lines.join('\n');

  MailApp.sendEmail(ERROR_EMAIL, ERROR_SUBJECT, body);
}

/**
 * Reads the ENABLED and PAUSED keywords of the given campaigns with a single
 * GAQL query, skipping excluded ad groups.
 * EXACT stays EXACT, PHRASE and BROAD become PHRASE.
 * Returns: { comparisonKey: notation }, e.g. { 'EXACT|tui': '[tui]', 'PHRASE|tui hotel': '"tui hotel"' }
 */
function collectSourceKeywords_(campaignIds) {
  var result = {};

  var rows = AdsApp.search(buildKeywordQuery_(campaignIds));
  while (rows.hasNext()) {
    var row = rows.next();

    if (isExcluded(row.adGroup.name)) {
      continue;
    }

    var normalized = normalize_(stripMatchType_(row.adGroupCriterion.keyword.text));
    if (!normalized) {
      continue;
    }

    var matchType = (row.adGroupCriterion.keyword.matchType === 'EXACT') ? 'EXACT' : 'PHRASE';
    result[buildKey_(matchType, normalized)] = formatKeyword_(normalized, matchType);
  }

  return result;
}

/** Builds the GAQL query for the source campaigns. */
function buildKeywordQuery_(campaignIds) {
  var conditions = [
    'ad_group_criterion.status IN ("ENABLED", "PAUSED")',
    'ad_group.status IN ("ENABLED", "PAUSED")',
    'ad_group_criterion.negative = FALSE'
  ];

  if (CAMPAIGN_STATUS) {
    conditions.push('campaign.status = "' + CAMPAIGN_STATUS + '"');
  } else {
    conditions.push('campaign.status != "REMOVED"');
  }

  if (campaignIds && campaignIds.length) {
    conditions.push('campaign.id IN (' + campaignIds.join(', ') + ')');
  }

  return 'SELECT ad_group.name, ' +
         'ad_group_criterion.keyword.text, ' +
         'ad_group_criterion.keyword.match_type ' +
         'FROM keyword_view ' +
         'WHERE ' + conditions.join(' AND ');
}

/**
 * Current entries of the negative keyword list.
 * Match type comes from getMatchType(), NOT from the notation in getText().
 * Returns: { comparisonKey: SharedNegativeKeyword }
 */
function getListEntries_(list) {
  var result = {};
  var it = list.negativeKeywords().get();
  while (it.hasNext()) {
    var negative = it.next();
    var normalized = normalize_(stripMatchType_(negative.getText()));
    if (normalized) {
      result[buildKey_(negative.getMatchType(), normalized)] = negative;
    }
  }
  return result;
}

/** Fetches the negative keyword list by its ID. */
function getNegativeKeywordList_(listId) {
  var it = AdsApp.negativeKeywordLists()
      .withIds([listId])
      .get();
  return it.hasNext() ? it.next() : null;
}

/** Comparison key including the match type. */
function buildKey_(matchType, normalizedText) {
  return matchType + '|' + normalizedText;
}

// Returns true if the ad group name contains one of the exclude strings (case-insensitive)
function isExcluded(adGroupName) {
  var lower = String(adGroupName).toLowerCase();
  for (var i = 0; i < EXCLUDE_ADGROUP_CONTAINS.length; i++) {
    if (lower.indexOf(EXCLUDE_ADGROUP_CONTAINS[i].toLowerCase()) !== -1) return true;
  }
  return false;
}

/** Renders a keyword in its match type notation. */
function formatKeyword_(text, matchType) {
  if (matchType === 'EXACT') {
    return '[' + text + ']';
  }
  if (matchType === 'PHRASE') {
    return '"' + text + '"';
  }
  return text;
}

/** Strips [] and "" from the keyword notation. */
function stripMatchType_(text) {
  return String(text).replace(/^\s*[\["]?\s*/, '').replace(/\s*[\]"]?\s*$/, '').trim();
}

/** Comparison key: lowercase, collapsed whitespace. */
function normalize_(text) {
  return String(text).toLowerCase().replace(/\s+/g, ' ').trim();
}

function countKeys_(obj) {
  var n = 0;
  for (var k in obj) { n++; }
  return n;
}
