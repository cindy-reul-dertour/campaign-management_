/**
 * Script Cross-Negativierung für Search Kampagnen - Hotel to Generic
 * Account: Dertour Hotels (single account level)
 *
 * Version: 1.0, last update 13/10/26 by CR
 *
 * What this script does:
 * exclude all existing keywords from "Hotel Adgroups" in "Generi Adgroup" of Destination Search campaigbs
 * 
 */

// --- Configuration ---

// Campaigns the script works on
var CAMPAIGN_IDS = ['11461989488'];

// Ad groups whose keywords are used as source
var SOURCE_ADGROUP_CONTAINS = '_Hotelnamen_';

// Ad groups that receive the negative keywords
var TARGET_ADGROUP_CONTAINS = '_Generic_';

// Ad groups containing these strings are skipped entirely
// (checked case-insensitive -> covers "zz-OLD" and "zz-old")
var EXCLUDE_ADGROUP_CONTAINS = ['zz-old'];

// Safety net: abort if fewer than X source keywords are found
// (prevents the list from being wiped on a misconfiguration).
var MIN_SOURCE_KEYWORDS = 1;

// --- Error notification ---
var ERROR_EMAIL = 'cindy.reul@dertour.com';     // recipient of the alert mail
var ERROR_SUBJECT = 'Fehlermeldung: Script fehlgeschlagen';
var SCRIPT_NAME = 'Script Cross-Negativierung für Search Kampagnen';        // name used in the body of the alert mail
var ACCOUNT_LABEL = 'Dertour Hotels';


// Entry point: runs the script and sends an alert email if anything crashes
function main() {
  try {
    run();
  } catch (e) {
    // Log the error, send the alert mail, then re-throw so the run is marked as failed
    Logger.log('ERROR: ' + e);
    sendErrorMail([String(e && e.stack ? e.stack : e)]);
    throw e;
  }
}


function run() {
  // Build the campaign ID list for the GAQL "IN (...)" filter
  var campaignFilter = CAMPAIGN_IDS.join(', ');

  // ------------------------------------------------------------------
  // STEP 1: Find target ad groups (_Generic_, enabled/paused, not zz-old)
  // ------------------------------------------------------------------
  var targetIds = [];           // list of target ad group IDs (numbers)

  // Query all enabled + paused ad groups of the configured campaigns
  // (removed ad groups are excluded by the status filter)
  var agQuery =
    'SELECT campaign.id, ad_group.id, ad_group.name ' +
    'FROM ad_group ' +
    'WHERE campaign.id IN (' + campaignFilter + ') ' +
    "AND ad_group.status IN ('ENABLED', 'PAUSED')";

  var agRows = AdsApp.search(agQuery);
  while (agRows.hasNext()) {
    var ag = agRows.next();
    var agName = ag.adGroup.name;

    // Skip zz-old ad groups
    if (isExcluded(agName)) continue;

    // Keep only ad groups whose name contains "_Generic_"
    if (agName.indexOf(TARGET_ADGROUP_CONTAINS) === -1) continue;

    targetIds.push(Number(ag.adGroup.id));
  }

  Logger.log('Target ad groups found: ' + targetIds.length);

  // ------------------------------------------------------------------
  // STEP 2: Read source keywords (positive keywords only)
  // ------------------------------------------------------------------
  var sourcesByCampaign = {};   // campaignId -> { key: {text, negType, sourceAdGroupId} }
  var sourceCount = 0;          // number of unique source keywords (per campaign)

  // Query all enabled + paused positive keywords
  // in enabled + paused ad groups of the configured campaigns
  var kwQuery =
    'SELECT campaign.id, ad_group.id, ad_group.name, ' +
    'ad_group_criterion.keyword.text, ad_group_criterion.keyword.match_type ' +
    'FROM ad_group_criterion ' +
    'WHERE campaign.id IN (' + campaignFilter + ') ' +
    "AND ad_group.status IN ('ENABLED', 'PAUSED') " +
    "AND ad_group_criterion.type = 'KEYWORD' " +
    'AND ad_group_criterion.negative = FALSE ' +
    "AND ad_group_criterion.status IN ('ENABLED', 'PAUSED')";

  var kwRows = AdsApp.search(kwQuery);
  while (kwRows.hasNext()) {
    var row = kwRows.next();
    var name = row.adGroup.name;

    // Skip zz-old ad groups
    if (isExcluded(name)) continue;

    // Only use keywords from ad groups containing "_Hotelnamen_"
    if (name.indexOf(SOURCE_ADGROUP_CONTAINS) === -1) continue;

    var campaignId = String(row.campaign.id);
    var adGroupId = String(row.adGroup.id);

    // Normalize keyword text (lowercase, no "+", single spaces)
    var text = normalizeText(row.adGroupCriterion.keyword.text);
    if (!text) continue;

    // Map match type: Exact -> Exact, Broad/Phrase -> Phrase
    var matchType = String(row.adGroupCriterion.keyword.matchType);
    var negType = (matchType === 'EXACT') ? 'EXACT' : 'PHRASE';

    // Unique key per keyword + negative match type
    var key = negType + '|' + text;

    // Store source keyword per campaign (duplicates are counted once)
    if (!sourcesByCampaign[campaignId]) sourcesByCampaign[campaignId] = {};
    if (!sourcesByCampaign[campaignId][key]) {
      sourcesByCampaign[campaignId][key] = {
        text: text,
        negType: negType,
        sourceAdGroupId: adGroupId
      };
      sourceCount++;
    }
  }

  Logger.log('Source keywords found (unique per campaign): ' + sourceCount);

  // Safety net: abort if too few source keywords were found
  if (sourceCount < MIN_SOURCE_KEYWORDS) {
    throw new Error('Aborted: only ' + sourceCount + ' source keywords found (minimum: ' +
      MIN_SOURCE_KEYWORDS + '). Please check campaign IDs and ad group names.');
  }

  // Nothing to target -> end the run
  if (targetIds.length === 0) {
    Logger.log('No target ad groups found – nothing to do.');
    return;
  }

  // ------------------------------------------------------------------
  // STEP 3: Read existing negatives on campaign level + negative keyword lists
  // ------------------------------------------------------------------
  var campaignNegatives = {};   // campaignId -> { text: {EXACT, PHRASE, BROAD} }

  var campaigns = AdsApp.campaigns()
    .withIds(CAMPAIGN_IDS.map(function (id) { return Number(id); }))
    .get();

  while (campaigns.hasNext()) {
    var campaign = campaigns.next();
    var cMap = {};

    // Campaign-level negative keywords
    addNegativesToMap(campaign.negativeKeywords().get(), cMap);

    // Negative keyword lists attached to the campaign
    var lists = campaign.negativeKeywordLists().get();
    while (lists.hasNext()) {
      addNegativesToMap(lists.next().negativeKeywords().get(), cMap);
    }

    campaignNegatives[String(campaign.getId())] = cMap;
  }

  // ------------------------------------------------------------------
  // STEP 4: Per target ad group: read its negatives, then add missing ones
  // ------------------------------------------------------------------
  var errors = [];
  var addedCount = 0;
  var skippedCount = 0;

  var adGroups = AdsApp.adGroups().withIds(targetIds).get();

  while (adGroups.hasNext()) {
    var adGroup = adGroups.next();
    var targetId = String(adGroup.getId());
    var cid = String(adGroup.getCampaign().getId());

    // Source keywords of the same campaign only
    var sources = sourcesByCampaign[cid];
    if (!sources) continue;

    // Existing negatives directly in this ad group
    var agMap = {};
    addNegativesToMap(adGroup.negativeKeywords().get(), agMap);

    // Existing negatives on campaign level / lists of this campaign
    var cMapForAg = campaignNegatives[cid] || {};

    var added = 0;

    // Check every source keyword against this target ad group
    for (var k in sources) {
      var src = sources[k];

      // Never exclude a keyword in its own ad group
      if (src.sourceAdGroupId === targetId) continue;

      // Skip if exactly this negative (same text + match type) already exists (ad group, campaign or list)
      if (isCovered(agMap, src.text, src.negType) || isCovered(cMapForAg, src.text, src.negType)) {
        skippedCount++;
        Logger.log('Already excluded, skipped: ' + adGroup.getName() + ' / ' + src.text + ' (' + src.negType + ')');
        continue;
      }

      // Build the negative keyword string: [exact] or "phrase"
      var negString = (src.negType === 'EXACT')
        ? '[' + src.text + ']'
        : '"' + src.text + '"';

      // Create the negative; collect errors instead of stopping the run
      try {
        adGroup.createNegativeKeyword(negString);
        addedCount++;
        added++;
        Logger.log('Added: ' + adGroup.getName() + ' / ' + negString);

        // Remember it, so it is not added twice within the same run
        markInMap(agMap, src.text, src.negType);
      } catch (err) {
        errors.push('Campaign "' + adGroup.getCampaign().getName() + '" / Ad group "' +
          adGroup.getName() + '" / Keyword ' + negString + ': ' + err);
      }
    }

    Logger.log(adGroup.getName() + ': ' + added + ' negatives added');
  }

  Logger.log('Done. Added: ' + addedCount + ' | Already existing (skipped): ' +
    skippedCount + ' | Errors: ' + errors.length);

  // Send alert mail if any single negative could not be created
  if (errors.length > 0) {
    sendErrorMail(errors);
  }
}


// --- Helper functions ---

// Reads negative keywords from an iterator into a map: text -> {EXACT, PHRASE, BROAD}
function addNegativesToMap(iterator, map) {
  while (iterator.hasNext()) {
    var neg = iterator.next();
    // getText() returns e.g. [hotel], "hotel" or hotel -> strip brackets/quotes
    var text = normalizeText(String(neg.getText()).replace(/[\[\]"]/g, ''));
    if (!text) continue;
    markInMap(map, text, String(neg.getMatchType()));
  }
}

// Marks a text + match type as existing in the map
function markInMap(map, text, matchType) {
  if (!map[text]) map[text] = {};
  map[text][matchType] = true;
}

// Checks whether exactly the same negative already exists
// (same text AND same match type: [exact] only matches [exact], "phrase" only matches "phrase")
function isCovered(map, text, negType) {
  var m = map[text];
  if (!m) return false;
  return !!m[negType];
}

// Returns true if the ad group name contains one of the exclude strings (case-insensitive)
function isExcluded(adGroupName) {
  var lower = String(adGroupName).toLowerCase();
  for (var i = 0; i < EXCLUDE_ADGROUP_CONTAINS.length; i++) {
    if (lower.indexOf(EXCLUDE_ADGROUP_CONTAINS[i].toLowerCase()) !== -1) return true;
  }
  return false;
}

// Normalizes keyword text so the duplicate check works reliably
function normalizeText(text) {
  return String(text || '')
    .toLowerCase()          // case-insensitive comparison
    .replace(/\+/g, '')     // remove legacy BMM "+" signs
    .replace(/\s+/g, ' ')   // collapse multiple spaces
    .trim();                // remove leading/trailing spaces
}

// Sends the alert mail (max. 50 error lines, rest is in the script log)
function sendErrorMail(errors) {
  var account = AdsApp.currentAccount();
  var maxLines = 50;
  var lines = errors.slice(0, maxLines);
  if (errors.length > maxLines) {
    lines.push('... and ' + (errors.length - maxLines) + ' more errors (see script log).');
  }

  var body =
    'Script: ' + SCRIPT_NAME + '\n' +
    'Account: ' + ACCOUNT_LABEL + ' (' + account.getCustomerId() + ')\n' +
    'Time: ' + Utilities.formatDate(new Date(), account.getTimeZone(), 'yyyy-MM-dd HH:mm:ss') + '\n\n' +
    'Errors:\n' + lines.join('\n');

  MailApp.sendEmail(ERROR_EMAIL, ERROR_SUBJECT, body);
}
